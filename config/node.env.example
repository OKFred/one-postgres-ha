# Generated per-node .env uses the pinned image values from versions.env.
# All addresses in this example are documentation-only addresses.
COMPOSE_PROFILES=core
NODE_IP=192.0.2.11
CONFIG_DIR=/opt/one-postgres-ha/config
SECRETS_DIR=/opt/one-postgres-ha/secrets
PG_DATA_DIR=/srv/postgres-ha/postgres
ETCD_DATA_DIR=/srv/postgres-ha/etcd
WATCHDOG_DEVICE=/dev/watchdog
