{% for setting in lookup('ansible.builtin.file', project_root + '/config/versions.env').splitlines() %}
{% if postgres_ha_image | length == 0 or not setting.startswith('POSTGRES_HA_IMAGE=') %}
{{ setting }}
{% endif %}
{% endfor %}
{% if postgres_ha_image | length > 0 %}
POSTGRES_HA_IMAGE={{ postgres_ha_image }}
{% endif %}
COMPOSE_PROJECT_NAME={{ compose_project_name }}
COMPOSE_PROFILES={{ 'core' if inventory_hostname in groups.core_nodes else '' }}
NODE_NAME={{ node_name }}
NODE_IP={{ node_ip }}
CONFIG_DIR={{ deployment_root }}/config
SECRETS_DIR={{ deployment_root }}/secrets
PG_DATA_DIR={{ data_root }}/postgres
ETCD_DATA_DIR={{ data_root }}/etcd
WATCHDOG_DEVICE={{ watchdog_device }}
WATCHDOG_GID={{ watchdog_gid }}
POSTGRES_MEMORY_MB={{ postgres_memory_mb }}
ETCD_MEMORY_MB={{ etcd_memory_mb }}
